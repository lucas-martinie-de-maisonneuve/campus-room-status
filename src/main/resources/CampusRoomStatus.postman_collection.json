{
  "info": {
    "name": "CampusRoomStatus",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "Buildings",
      "item": [
        {
          "name": "GET all buildings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/buildings",
              "host": ["{{base_url}}"],
              "path": ["buildings"]
            }
          }
        },
        {
          "name": "GET building by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/buildings/1",
              "host": ["{{base_url}}"],
              "path": ["buildings", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "GET all rooms",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms",
              "host": ["{{base_url}}"],
              "path": ["rooms"]
            }
          }
        },
        {
          "name": "GET rooms - filter by building",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?building=La-Plateforme-Hangar",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "building", "value": "La-Plateforme-Hangar" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - filter by status available",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?status=available",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "status", "value": "available" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - filter by status occupied",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?status=occupied",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "status", "value": "occupied" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - filter by building + status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?building=La-Plateforme-Hangar&status=available",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "building", "value": "La-Plateforme-Hangar" },
                { "key": "status", "value": "available" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - filter by type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?type=Salle",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "type", "value": "Salle" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - filter by capacity_min",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?capacity_min=20",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "capacity_min", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - filter by capacity range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?capacity_min=10&capacity_max=50",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "capacity_min", "value": "10" },
                { "key": "capacity_max", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - sort by capacity asc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?sort=capacity&order=asc",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "sort", "value": "capacity" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - sort by capacity desc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?sort=capacity&order=desc",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "sort", "value": "capacity" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - sort by name asc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?sort=name&order=asc",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "sort", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "GET rooms - combined filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms?building=La-Plateforme-Hangar&capacity_min=10&sort=capacity&order=asc",
              "host": ["{{base_url}}"],
              "path": ["rooms"],
              "query": [
                { "key": "building", "value": "La-Plateforme-Hangar" },
                { "key": "capacity_min", "value": "10" },
                { "key": "sort", "value": "capacity" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "GET room by code",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/Vert-01-RDC-La-Plateforme-Hangar",
              "host": ["{{base_url}}"],
              "path": ["rooms", "Vert-01-RDC-La-Plateforme-Hangar"]
            }
          }
        },
        {
          "name": "GET rooms by building - Hangar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/buildings/La-Plateforme-Hangar",
              "host": ["{{base_url}}"],
              "path": ["rooms", "buildings", "La-Plateforme-Hangar"]
            }
          }
        },
        {
          "name": "GET rooms by building - Martigues",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/buildings/La-Plateforme-Martigues",
              "host": ["{{base_url}}"],
              "path": ["rooms", "buildings", "La-Plateforme-Martigues"]
            }
          }
        },
        {
          "name": "GET rooms by building - Online",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/buildings/La-Plateforme-Online",
              "host": ["{{base_url}}"],
              "path": ["rooms", "buildings", "La-Plateforme-Online"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "GET schedule this week",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/Vert-01-RDC-La-Plateforme-Hangar/schedule",
              "host": ["{{base_url}}"],
              "path": ["rooms", "Vert-01-RDC-La-Plateforme-Hangar", "schedule"]
            }
          }
        },
        {
          "name": "GET schedule by period",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/Vert-01-RDC-La-Plateforme-Hangar/schedule?start=2026-03-09&end=2026-03-15",
              "host": ["{{base_url}}"],
              "path": ["rooms", "Vert-01-RDC-La-Plateforme-Hangar", "schedule"],
              "query": [
                { "key": "start", "value": "2026-03-09" },
                { "key": "end", "value": "2026-03-15" }
              ]
            }
          }
        },
        {
          "name": "GET schedule current week",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/rooms/Vert-01-RDC-La-Plateforme-Hangar/schedule?start=2026-03-16&end=2026-03-20",
              "host": ["{{base_url}}"],
              "path": ["rooms", "Vert-01-RDC-La-Plateforme-Hangar", "schedule"],
              "query": [
                { "key": "start", "value": "2026-03-16" },
                { "key": "end", "value": "2026-03-20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "GET token (refresh token vide uniquement)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/get-token",
              "host": ["{{base_url}}"],
              "path": ["get-token"]
            }
          }
        }
      ]
    }
  ]
}